{
  "include": ["src"],
  "compilerOptions": {
    "target": "es2022",
    "module": "commonjs",
    "lib": [
      "es2023"
    ],
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "sourceMap": true,
    "declaration": true,
    "outDir": "dist",
    "skipLibCheck": true, // fixes build failures due to dependencies
  }
}
