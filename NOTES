   //
    // Should types be functions?
    //
    // parameters are the same for all constructors
    // indices vary from constructor to constructor
    //
    // type Empty = /* no constructors */
    //
    // -- can specify parenthesis and type for each constructor:
    // type Unit =
    //  one() : Unit
    //
    // type Bool =
    //  true |
    //  false
    //
    // desugars to:
    //
    // func Bool(): ★ = ιb. ΠP:Bool→★. P(Bool.true) → P(Bool.false) → P(b)
    // func true(): Bool = \P. \t. \f. t
    // func false(): Bool = \P. \t. \f. f
    //
    // type Pair(A:★, B:★) =
    //  pair(A:★, B:★, a:A, b:B) : Pair(A,B)
    //
    // desugars to:
    // func Pair(A:★, B:★): ★ = λA. λB. ΠC:★. (A -> B -> C) -> C
    // func pair(A:★, B:★, a:A, b:B): Pair(A,B) = λA. λB. λa. λb. λc. λf. f(a)(b)
    // js-style:
    // func pair = (A:★,B:★,a:A,b:B,c:★,f): Pair(A,B) => f(a,b)
    //
    //
    //
    // and : Type -> Type -> Type
    // and = λp. λq. Πc:★. (p -> q -> c) -> c
    // conj : Πp:★. Πq:★. p -> q -> and p q
    // conj = λp. λq. λx. λy. λc. λf. f x y
    //
    // type Maybe(T:★) =
    //  just(T:★, v:T) : Maybe(T) |
    //  nothing(T:★) : Maybe(T)
    //
    // type List(T:★) =
    //  nil(T:★) : List(T) |
    //  cons(T:★, head:T, tail:List(T)) : List(T)
    //
    // example: nil(Int) : List(Int)
    // example: cons(Int, 0, nil(Int)) : List(Int)
    // example: cons(Int, 1, cons(Int, 2, nil(Int))) : List(Int)
    //
    //
    //
    // type Vector(T:★, n:Nat) =
    //  vnil(T:★) : Vector(T,0) |
    //  vcons(T:★, n:Nat, head:T, tail:Vector(T,n)) : Vector(T,succ(n))
    //
    // example: vcons(Nat, 1, vcons(Nat, 3, vnil(Nat))) : Vector(Nat,2)
    //
    //
    //
    //
    // Identity type
    //
    // data Id (A : Type) (x : A) : A → Type
    //  refl : Id A x x
    //
    //
    // type Equal(A:★, x:A, y:A) =
    //  refl(A:★, x:A) : Equal(A,x,x)
    //
    // func refl(A:★, x:A): Equal(A,x,x) = ???
    //
    //
    // type Equal(A:★,x:A) : (y:A) -> ★ =
    //  refl() : Equal(A,x,x)
    //
    // refl(Nat, 2, plus(1, 1))
    //
    //
    // type Nat =
    //  zero():Nat |
    //  succ(prev: Nat):Nat
    //
    // succ(succ(zero())): Nat
    //
    //
    // type X = Int | String
    // let x = 1:X
    // let y = case x of
    //  Int => x
    //  String => 0
    // List<Int|String>
    // [1,2,"three"]:List<Int|String>




