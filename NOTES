// An expression is
//  - an atom
//  - parenthesis
//  - prefix
// followed by:
//  - postfix operators ([,!)
//  - infix operators (+,*)
//
// infix binding power
//  + is (1,2)
//  * is (3,4)
//
// a + b * c
//0 1 2 3 4 0
//

// const expressionUpToBindingPower = (minimum: number): Parser<Expression> =>
//   bind(integerLiteral, (lhs) =>
//     either(
//       bind(char("+"), (_) =>
//         bind(expressionUpToBindingPower(2), (rhs) => pure(IntPlus(lhs, rhs)))
//       ),
//       bind(char("*"), (_) =>
//         bind(expressionUpToBindingPower(4), (rhs) => pure(IntMul(lhs, rhs)))
//       )
//     )
//   );

// const parseRhs = (
//   minimum: number,
//   lhs: IntLit | IntPlus | IntMul
// ): Parser<IntPlus | IntMul | IntLit> => {
//   const opPlus = bind(char("+"), (_) =>
//     bind(expressionUpToBindingPower2(2), (rhs) => pure(IntPlus(lhs, rhs)))
//   );
//   const opMul = bind(char("*"), (_) =>
//     bind(expressionUpToBindingPower2(4), (rhs) => pure(IntMul(lhs, rhs)))
//   );
//   return (input): Result<IntPlus | IntMul | IntLit> => {
//     if (minimum < 1) {
//       const left = opPlus(input);
//       if (left._ == "outputvalue") {
//         return left;
//       }
//     }
//     if (minimum < 3) {
//       const left = opMul(input);
//       if (left._ == "outputvalue") {
//         return left;
//       }
//     }
//     return pure(lhs)(input);
//   };
// };

